  "metrics": {
    "model_capability_coverage": {
      "description": "Model yeteneklerinin test senaryoları tarafından kapsanma yüzdesi",
      "target": ">98%"
    },
    "edge_case_coverage": {
      "description": "Uç durum senaryolarının kapsanma yüzdesi",
      "target": ">95%"
    },
    "performance_boundary_coverage": {
      "description": "Performans sınırlarının test senaryoları tarafından kapsanma yüzdesi",
